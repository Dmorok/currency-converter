{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "3.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "D.Morok",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extShortName__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://bank.gov.ua/*",
    "https://cdn.moneyconvert.net/*",
    "https://cdn.jsdelivr.net/*",
    "https://latest.currency-api.pages.dev/*",
    "https://open.er-api.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "__MSG_openPopup__"
    }
  }
}